{
  "expo": {
    "name": "Servell",
    "slug": "authWithTabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/logoV2_2.png",
    "scheme": "servell",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xfliozkies.servell",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Servell needs your location to show services near you and to let you pin your service location on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "assets/images/logoV2_2.png",
        "backgroundImage": "assets/images/android-icon-background.png",
        "monochromeImage": "assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xfliozkies.servell",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Servell needs your location to show services near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyD3N7kqEw9XqD9JVTEdf_6lYV5z3ZGzOLo",
          "iosGoogleMapsApiKey": "AIzaSyD3N7kqEw9XqD9JVTEdf_6lYV5z3ZGzOLo"
        }
      ],
      "expo-video",
      [
        "./plugins/withGoogleMobileAds",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e25502f3-e29d-4c28-8c92-91ce673e73ec"
      }
    },
    "owner": "xfliozkies"
  }
}
